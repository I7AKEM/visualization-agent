{
  "name": "visualization-agent-production",
  "version": "0.0.0",
  "private": true,
  "description": "Production workspace for the Visualization Agent platform.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.20.0",
    "pnpm": "10.34.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "audit:prod": "corepack pnpm audit --prod --audit-level high",
    "build": "corepack pnpm -r --if-present build",
    "check:peers": "node scripts/check-peer-compatibility.mjs",
    "check:runtime": "node scripts/check-runtime-pins.mjs",
    "lint": "corepack pnpm -r --if-present lint",
    "presbom": "node scripts/prepare-sbom.mjs",
    "sbom": "node scripts/generate-node-sbom.mjs",
    "test": "corepack pnpm run test:foundation && corepack pnpm -r --if-present test:unit",
    "test:compat": "corepack pnpm run test:foundation && corepack pnpm --filter @visualization-agent/web test:compat",
    "test:foundation": "node --test tests/compatibility/node/*.test.mjs",
    "test:unit": "corepack pnpm -r --if-present test:unit",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "verify": "corepack pnpm run check:runtime && corepack pnpm run check:peers && corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run test && corepack pnpm run build"
  },
  "devDependencies": {
    "@cyclonedx/cdxgen": "12.8.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "fast-check": "4.9.0",
    "jsdom": "30.0.1",
    "semver": "7.7.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "zod": "4.1.8"
  }
}
